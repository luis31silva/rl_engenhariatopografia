# Copiar para .env e ajustar.

APP_NAME="RL Eng & Top - Gestão"
ENVIRONMENT=development

# Base de dados.
# Dev local (sem MySQL): deixar comentado para usar SQLite.
# Produção (Aiven MySQL):
# DATABASE_URL=mysql+pymysql://utilizador:password@host:porta/nome_bd
# DATABASE_URL=sqlite:///./dev.db

# Autenticação. Gerar uma chave forte em produção (ex.: openssl rand -hex 32).
SECRET_KEY=dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Utilizador inicial (usado por `python -m app.seed`). Definir password forte em produção.
INITIAL_USERNAME=admin
INITIAL_PASSWORD=admin

# Dados do gabinete (aparecem nas faturas/recibos PDF).
EMPRESA_NOME="RL - Engenharia & Topografia"
EMPRESA_MORADA=""
EMPRESA_NIF=""
EMPRESA_CONTACTO=""

# CORS: origens permitidas, separadas por vírgula.
CORS_ORIGINS=http://localhost:5173
